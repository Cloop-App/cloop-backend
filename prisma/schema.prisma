}

model english_topic_goals {
  id          Int            @id @default(autoincrement())
  topic_id    Int
  title       String         @db.VarChar(200)
  description String?        @db.Text
  order       Int            @default(1)
  created_at  DateTime?      @default(now()) @db.Timestamp(6)
