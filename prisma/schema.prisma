model english_chapters {
  id                 Int              @id @default(autoincrement())
  subject_id         Int
  title              String           @db.VarChar(200)
  description        String?          @db.Text
  badge_level        String?          @default("Intermediate") @db.VarChar(50)
  order              Int              @default(1)
  created_at         DateTime?        @default(now()) @db.Timestamp(6)
  subject            english_subjects @relation(fields: [subject_id], references: [id], onDelete: Cascade)
