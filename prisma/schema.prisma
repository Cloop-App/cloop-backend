  users                   users?    @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id, created_at])
  @@index([feature_area, created_at])
  @@index([model_name, created_at])
  @@index([created_at])
}

model ai_user_daily_token_usage {
  id                       Int      @id @default(autoincrement())
  user_id                  Int
  date                     DateTime @db.Date
  feature_area             String   @db.VarChar(50)
  total_prompt_tokens      BigInt   @default(0)
  total_completion_tokens  BigInt   @default(0)
  total_tokens             BigInt   @default(0)
  total_calls              Int      @default(0)
  updated_at               DateTime @default(now()) @updatedAt @db.Timestamp(6)

  users                    users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, date, feature_area])
