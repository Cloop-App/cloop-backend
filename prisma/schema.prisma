  weak_language     Json?
  weak_situations   Json?
  track_preferences Json?
  current_track     String?   @db.VarChar(50)
  current_chapter   String?   @db.VarChar(100)
  open_errors       Json?
  total_sessions    Int       @default(0)
  total_minutes     Int       @default(0)
