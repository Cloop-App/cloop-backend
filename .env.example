# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cloop?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRY="7d"

# OpenAI
OPENAI_API_KEY="sk-your-openai-key-here"

# Media suggestions (OPTIONAL). Without these the tutor falls back to
# deterministic YouTube/Google search URLs that always work — no key required.
# Set YOUTUBE_API_KEY to resolve a specific top video (id + thumbnail).
YOUTUBE_API_KEY=""

# Expo Push Notifications (mobile only)
EXPO_ACCESS_TOKEN=""

# CORS - comma separated allowed origins
CORS_ALLOWED_ORIGINS="https://app.cloopapp.com,https://api.cloopapp.com"

# Server
PORT=3000
NODE_ENV="development"
