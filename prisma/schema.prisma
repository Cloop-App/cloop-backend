generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model boards {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  country     String?   @db.VarChar(100)
  description String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model languages {
  id          Int       @id @default(autoincrement())
  code        String    @unique @db.VarChar(10)
  name        String    @db.VarChar(100)
  native_name String?   @db.VarChar(100)
  is_active   Boolean?  @default(true)
  created_at  DateTime? @default(now()) @db.Timestamp(6)
}

model users {
  user_id                   Int                         @id @default(autoincrement())
  name                      String                      @db.VarChar(100)
  email                     String                      @unique @db.VarChar(100)
  created_at                DateTime?                   @default(now()) @db.Timestamp(6)
  num_chats                 Int?                        @default(0)
  num_lessons               Int?                        @default(0)
  grade_level               String?                     @db.VarChar(50)
  board                     String?                     @db.VarChar(50)
  subjects                  String[]
  preferred_language        String?                     @db.VarChar(50)
  study_goal                String?
  avatar_url                String?
  avatar_choice             String?                     @db.VarChar(50)
  phone                     String?                     @db.VarChar(50)
  expo_push_token           String?
  admin_chat                admin_chat[]
  chat_goal_progress        chat_goal_progress[]
  learning_turns            learning_turns[]
  tutor_sessions            tutor_sessions[]
  normal_user_chat          normal_user_chat[]
  normal_chat_sessions      normal_chat_sessions[]
  notifications             notifications[]
  saved_topics              saved_topics[]
  study_sessions            study_sessions[]
  user_topic_reports        user_topic_reports[]
  feedback                  feedback[]
  practice_tests            practice_tests[]
  ai_token_logs             ai_token_logs[]
  ai_user_daily_token_usage ai_user_daily_token_usage[]
  user_english_progress     user_english_progress[]
  web_search_logs           web_search_logs[]
  // --- Global Curriculum Relations ---
  subject_enrollments       user_subject_enrollment[]
  chapter_progress          user_chapter_progress[]
  topic_progress            user_topic_progress[]
  // --- English Speaking Assessment ---
  assessment_sessions       assessment_sessions[]
  // --- Voice Practice Sessions ---
  voice_sessions            voice_sessions[]
  learner_profile           learner_profiles?
  // --- Deprecated (old per-user curriculum) ---
  chapters_deprecated       chapters[]
  topics_deprecated         topics[]
  user_subjects_deprecated  user_subjects[]
  content_generation_status_deprecated content_generation_status[]
}

model practice_tests {
  id               Int       @id @default(autoincrement())
  user_id          Int
  exam_type        String    @db.VarChar(50)
  subject          String?   @db.VarChar(100)
  total_questions  Int       @default(15)
  score            Int?      @default(0)
  time_taken_sec   Int?      @default(0)
  status           String    @default("in_progress") @db.VarChar(20)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  completed_at     DateTime? @db.Timestamp(6)

  users            users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  questions        practice_questions[]
  selected_chapters practice_test_chapters[]
}

model practice_test_chapters {
  id           Int               @id @default(autoincrement())
  test_id      Int
  chapter_id   Int
  practice_test practice_tests  @relation(fields: [test_id], references: [id], onDelete: Cascade)
  chapter       standard_chapters @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@unique([test_id, chapter_id])
}

model standard_exams {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  subjects    standard_subjects[]
}

model standard_subjects {
  id          Int      @id @default(autoincrement())
  exam_id     Int
  name        String   @db.VarChar(100)
  exam        standard_exams @relation(fields: [exam_id], references: [id], onDelete: Cascade)
  chapters    standard_chapters[]
}

model standard_chapters {
  id          Int      @id @default(autoincrement())
  subject_id  Int
  title       String   @db.VarChar(200)
  order       Int?
  subject     standard_subjects @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  practice_tests practice_test_chapters[]
  questions      practice_questions[]
}

model practice_questions {
  id               Int       @id @default(autoincrement())
  test_id          Int
  chapter_id       Int?      // Link to the specific standard chapter
  question_text    String    @db.Text
  options          Json      // Array of strings
  correct_answer   String
  explanation      String?   @db.Text
  user_answer      String?
  is_correct       Boolean?
  time_spent_sec   Int?      @default(0) // How long user took
  ideal_time_sec   Int?      @default(60) // AI suggested time
  difficulty       String?   @db.VarChar(20) // 'Easy', 'Medium', 'Hard'
  created_at       DateTime? @default(now()) @db.Timestamp(6)

  practice_tests   practice_tests @relation(fields: [test_id], references: [id], onDelete: Cascade)
  chapter          standard_chapters? @relation(fields: [chapter_id], references: [id])
}

// ============================================================
// DEPRECATED: Old per-user curriculum tables (kept for reference/rollback)
// DO NOT write new data to these tables. Use global_* tables instead.
// ============================================================

model subjects {
  id                        Int                         @id @default(autoincrement())
  code                      String?                     @unique
  name                      String
  category                  String?
  chapters                  chapters[]
  content_generation_status content_generation_status[]
  topics                    topics[]
  user_subjects             user_subjects[]
}

model chapters {
  id                 Int       @id @default(autoincrement())
  subject_id         Int
  user_id            Int
  title              String
  content            String?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  total_topics       Int?      @default(0)
  completed_topics   Int?      @default(0)
  completion_percent Decimal?  @default(0.00) @db.Decimal(5, 2)
  subjects           subjects  @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chapters_subject")
  users              users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chapters_user")
  topics             topics[]
}

model topics {
  id                 Int                  @id @default(autoincrement())
  subject_id         Int
  chapter_id         Int
  user_id            Int
  title              String
  content            String?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  is_completed       Boolean?             @default(false)
  completion_percent Decimal?             @default(0.00) @db.Decimal(5, 2)
  time_spent_seconds Int?                 @default(0)
  topic_goals        topic_goals[]
  chapters           chapters             @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_topics_chapter")
  subjects           subjects             @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_topics_subject")
  users              users                @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_topics_user")
}

model topic_goals {
  id                 Int                  @id @default(autoincrement())
  topic_id           Int
  title              String
  description        String?
  order              Int?
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  topics             topics               @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_topic")
}

// ============================================================
// GLOBAL CURRICULUM TABLES (new architecture)
// One shared catalog per board+grade+subject combination
// ============================================================

/// Global catalog: one row per board+grade+subject combination
model global_subjects {
  id          Int                @id @default(autoincrement())
  board       String             @db.VarChar(100)
  grade       String             @db.VarChar(50)
  name        String             @db.VarChar(100)
  code        String?            @db.VarChar(50)
  category    String?            @db.VarChar(50)
  created_at  DateTime?          @default(now()) @db.Timestamp(6)
  updated_at  DateTime?          @default(now()) @db.Timestamp(6)

  chapters    global_chapters[]
  enrollments user_subject_enrollment[]

  @@unique([board, grade, name])
}

/// Global chapter catalog (no user_id — shared across all users)
model global_chapters {
  id          Int              @id @default(autoincrement())
  subject_id  Int
  title       String           @db.VarChar(200)
  content     String?          @db.Text
  order       Int              @default(1)
  created_at  DateTime?        @default(now()) @db.Timestamp(6)

  subject     global_subjects  @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  topics      global_topics[]
  user_progress user_chapter_progress[]

  @@index([subject_id])
}

/// Global topic catalog (no user_id — shared across all users)
model global_topics {
  id                 Int                    @id @default(autoincrement())
  chapter_id         Int
  subject_id         Int
  title              String                 @db.VarChar(200)
  content            String?                @db.Text
  order              Int                    @default(1)
  created_at         DateTime?              @default(now()) @db.Timestamp(6)

  chapter            global_chapters        @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  goals              global_topic_goals[]
  user_progress      user_topic_progress[]
  saved_topics       saved_topics[]
  study_sessions     study_sessions[]
  user_topic_reports user_topic_reports[]
  tutor_sessions     tutor_sessions[]

  @@index([chapter_id])
  @@index([subject_id])
}

/// Global learning goals catalog (no user_id — shared across all users)
model global_topic_goals {
  id                 Int                  @id @default(autoincrement())
  topic_id           Int
  title              String               @db.VarChar(200)
  description        String?              @db.Text
  order              Int                  @default(1)
  created_at         DateTime?            @default(now()) @db.Timestamp(6)

  topic              global_topics        @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  chat_goal_progress chat_goal_progress[] @relation("GoalToProgress")
  learning_turns     learning_turns[]

  @@index([topic_id])
}

/// Tracks generation status per board+grade+subject (replaces per-user content_generation_status)
model global_curriculum_status {
  id                      Int       @id @default(autoincrement())
  board                   String    @db.VarChar(100)
  grade                   String    @db.VarChar(50)
  subject_name            String    @db.VarChar(100)
  global_subject_id       Int?
  chapters_generated      Boolean   @default(false)
  topics_generated        Boolean   @default(false)
  goals_generated         Boolean   @default(false)
  status                  String    @default("pending") @db.VarChar(50)
  error_message           String?
  generation_started_at   DateTime? @db.Timestamp(6)
  generation_completed_at DateTime? @db.Timestamp(6)
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)

  @@unique([board, grade, subject_name])
  @@index([status])
}

// ============================================================
// USER PROGRESS TABLES (per-user tracking against global catalog)
// ============================================================

/// Links a user to a global_subject (enrollment / subscription)
model user_subject_enrollment {
  id          Int              @id @default(autoincrement())
  user_id     Int
  subject_id  Int
  enrolled_at DateTime?        @default(now()) @db.Timestamp(6)

  user        users            @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  subject     global_subjects  @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([user_id, subject_id])
  @@index([user_id])
}

/// Per-user chapter progress tracking
model user_chapter_progress {
  id                 Int              @id @default(autoincrement())
  user_id            Int
  chapter_id         Int
  total_topics       Int              @default(0)
  completed_topics   Int              @default(0)
  completion_percent Decimal          @default(0.00) @db.Decimal(5, 2)
  last_accessed_at   DateTime?        @db.Timestamp(6)
  created_at         DateTime?        @default(now()) @db.Timestamp(6)

  user               users            @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  chapter            global_chapters  @relation(fields: [chapter_id], references: [id], onDelete: Cascade)

  @@unique([user_id, chapter_id])
  @@index([user_id])
}

/// Per-user topic progress tracking
model user_topic_progress {
  id                 Int            @id @default(autoincrement())
  user_id            Int
  topic_id           Int
  is_completed       Boolean        @default(false)
  completion_percent Decimal        @default(0.00) @db.Decimal(5, 2)
  time_spent_seconds Int            @default(0)
  last_accessed_at   DateTime?      @db.Timestamp(6)
  created_at         DateTime?      @default(now()) @db.Timestamp(6)

  user               users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  topic              global_topics  @relation(fields: [topic_id], references: [id], onDelete: Cascade)

  @@unique([user_id, topic_id])
  @@index([user_id])
}

/// One tutoring session: one student working through one topic.
///
/// Production had no session entity. Nothing tied a run of admin_chat messages
/// to a topic, and there was nowhere to keep the state machine between turns,
/// so `chat_id` came to mean "the id of one chat message" — which is why
/// chat_goal_progress ended up with 2,209 rows covering only 137 goals, one
/// written per message rather than one per goal, 32% of them recording no
/// question at all. Reading those rows as goals is what made goal completion
/// look like 41%; on the real grain it was 67%.
///
/// `state` is the server-owned session state from tutor-core/state.js. It has
/// to be durable: without it every turn reconstructs a fresh state and the
/// student is returned to PROBE forever, never reaching WRAP and never
/// receiving a mastery report.
model tutor_sessions {
  id           Int       @id @default(autoincrement())
  user_id      Int
  topic_id     Int
  state        Json
  /// The session's first chat message, used as its stable id in
  /// chat_goal_progress — whose unique key is (chat_id, goal_id, user_id).
  /// Keying that on the current turn's message instead is what produced the
  /// pilot's 2,209 progress rows across 137 goals: a new row per message.
  anchor_chat_id Int?
  is_active    Boolean   @default(true)
  ended_reason String?   @db.VarChar(30)
  started_at   DateTime? @default(now()) @db.Timestamp(6)
  ended_at     DateTime? @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)

  users        users         @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tutor_sessions_user")
  topic        global_topics @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tutor_sessions_topic")
  messages     admin_chat[]

  @@index([user_id, topic_id])
  @@index([user_id, is_active])
}

model admin_chat {
  id                 Int                  @id @default(autoincrement())
  user_id            Int
  session_id         Int?
  sender             String?              @db.VarChar(50)
  message            String?
  message_type       String?              @default("text") @db.VarChar(50)
  diff_html          String?
  options            String[]
  images             String[]
  videos             String[]
  links              String[]
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  emoji              String?              @db.VarChar(10)
  users              users                @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_admin_chat_user")
  session            tutor_sessions?      @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_admin_chat_session")
  chat_goal_progress chat_goal_progress[] @relation("AdminChatToGoalProgress")
  chat_process       chat_process[]       @relation("AdminChatToProcess")
  learning_turns     learning_turns[]

  @@index([session_id], map: "idx_admin_chat_session")
}

model chat_process {
  id                 Int                  @id @default(autoincrement())
  chat_id            Int
  user_message       String?
  corrected_message  String?
  ai_response        String?
  wrong_message      String?
  feedback           Json?
  images             String[]
  videos             String[]
  links              String[]
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  updated_at         DateTime?            @default(now()) @db.Timestamp(6)
  chat_goal_progress chat_goal_progress[] @relation("ProcessToGoalProgress")
  admin_chat         admin_chat           @relation("AdminChatToProcess", fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_process_admin_chat")
}

model chat_goal_progress {
  id               Int                @id @default(autoincrement())
  chat_id          Int
  goal_id          Int
  user_id          Int
  is_completed     Boolean?           @default(false)
  num_questions    Int?               @default(0)
  num_correct      Int?               @default(0)
  num_incorrect    Int?               @default(0)
  last_question_id Int?
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  updated_at       DateTime?          @default(now()) @db.Timestamp(6)
  admin_chat       admin_chat         @relation("AdminChatToGoalProgress", fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_goal_progress_admin_chat")
  chat_process     chat_process?      @relation("ProcessToGoalProgress", fields: [last_question_id], references: [id], onUpdate: NoAction, map: "fk_chat_goal_progress_last_question")
  global_topic_goals global_topic_goals @relation("GoalToProgress", fields: [goal_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_goal_progress_global_goal")
  users            users              @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_goal_progress_user")

  @@unique([chat_id, goal_id, user_id])
}

// DEPRECATED: Use user_subject_enrollment instead
model user_subjects {
  id                 Int       @id @default(autoincrement())
  user_id            Int
  subject_id         Int
  total_chapters     Int?      @default(0)
  completed_chapters Int?      @default(0)
  completion_percent Decimal?  @default(0.00) @db.Decimal(5, 2)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  subjects           subjects  @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_subjects_subject")
  users              users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_subjects_user")

  @@unique([user_id, subject_id])
}

model content_generation_status {
  id                      Int       @id @default(autoincrement())
  user_id                 Int
  subject_id              Int
  grade_level             String    @db.VarChar(50)
  board                   String    @db.VarChar(50)
  chapters_generated      Boolean?  @default(false)
  topics_generated        Boolean?  @default(false)
  generation_started_at   DateTime? @db.Timestamp(6)
  generation_completed_at DateTime? @db.Timestamp(6)
  status                  String?   @default("pending") @db.VarChar(50)
  error_message           String?
  created_at              DateTime? @default(now()) @db.Timestamp(6)
  updated_at              DateTime? @default(now()) @db.Timestamp(6)
  goals_generated         Boolean?  @default(false)
  subjects                subjects  @relation(fields: [subject_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_content_gen_status_subject")
  users                   users     @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_content_gen_status_user")

  @@unique([user_id, subject_id, grade_level, board])
  @@index([status], map: "idx_content_gen_status")
  @@index([user_id], map: "idx_content_gen_user_id")
}

model grade_levels {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)
}

model normal_chat_sessions {
  id         Int                @id @default(autoincrement())
  user_id    Int
  title      String?            @db.VarChar(200)
  created_at DateTime?          @default(now()) @db.Timestamp(6)
  updated_at DateTime?          @default(now()) @db.Timestamp(6)
  users      users              @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  messages   normal_user_chat[]

  @@index([user_id])
}

model normal_user_chat {
  id           Int                  @id @default(autoincrement())
  user_id      Int
  session_id   Int?
  from_report_id Int?               // Link back to practice test
  from_q_index String?              // Link back to specific question index
  sender       String               @db.VarChar(50)
  message      String?
  message_type String?              @default("text") @db.VarChar(50)
  images       String[]             @default([])
  videos       String[]             @default([])
  links        String[]             @default([])
  emoji        String?              @db.VarChar(10)
  created_at   DateTime?            @default(now()) @db.Timestamp(6)
  users        users                @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_normal_user_chat_user")
  session      normal_chat_sessions? @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([user_id], map: "idx_normal_user_chat_user_id")
  @@index([session_id])
}

/// One row per graded student turn.
///
/// The `phase`, `directive`, `intent`, `escalation_step` and `turn_number`
/// columns are the tutor-core instrumentation. Without them a session's
/// pedagogy cannot be audited after the fact: the pilot could show that 70.8%
/// of answers were correct but not which phase the student was in, which
/// teaching directive produced the turn, or how far down the escalation ladder
/// a stuck student was taken. They are written by services/tutor-core/persistence.js.
model learning_turns {
  id                   Int                 @id @default(autoincrement())
  user_id              Int
  chat_id              Int
  goal_id              Int?
  topic_id             Int?
  subject_id           Int?
  user_name            String?
  sender               String?
  question_text        String?
  user_answer_raw      String?
  corrected_answer     String?
  diff_html            String?
  feedback_text        String?
  feedback_json        Json?
  error_type           String?
  error_subtype        String?
  is_correct           Boolean?            @default(false)
  score_percent        Float?              @default(0)
  response_time_sec    Float?              @default(0)
  help_requested       String?             @db.VarChar(50)
  explain_loop_count   Int?                @default(0)
  num_retries          Int?                @default(0)
  goal_progress_before Float?              @default(0)
  goal_progress_after  Float?              @default(0)
  mastery_score        Float?              @default(0)
  difficulty_level     String?             @db.VarChar(50)
  topic_title          String?
  subject_name         String?
  question_type        String?
  phase                String?             @db.VarChar(20)
  directive            String?             @db.VarChar(50)
  intent               String?             @db.VarChar(20)
  escalation_step      Int?                @default(0)
  turn_number          Int?                @default(0)
  created_at           DateTime?           @default(now()) @db.Timestamp(6)
  updated_at           DateTime?           @default(now()) @db.Timestamp(6)
  admin_chat           admin_chat          @relation(fields: [chat_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_learning_chat")
  global_topic_goals   global_topic_goals? @relation(fields: [goal_id], references: [id], onUpdate: NoAction, map: "fk_learning_global_goal")
  users                users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_learning_user")

  @@index([user_id, created_at], map: "idx_learning_turns_user_created")
  @@index([chat_id, turn_number], map: "idx_learning_turns_chat_turn")
  @@index([goal_id], map: "idx_learning_turns_goal")
  @@index([phase], map: "idx_learning_turns_phase")
}

model saved_topics {
  id         Int            @id @default(autoincrement())
  user_id    Int
  topic_id   Int
  created_at DateTime?      @default(now()) @db.Timestamp(6)
  topic      global_topics  @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_saved_topics_global_topic")
  users      users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_saved_topics_user")

  @@unique([user_id, topic_id])
}

model user_topic_reports {
  id                Int            @id @default(autoincrement())
  user_id           Int
  topic_id          Int
  total_questions   Int
  correct_answers   Int
  incorrect_answers Int
  score_percent     Float
  star_rating       Int
  performance_level String         @db.VarChar(50)
  metrics_json      Json?
  created_at        DateTime?      @default(now()) @db.Timestamp(6)
  updated_at        DateTime?      @default(now()) @db.Timestamp(6)
  topic             global_topics  @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_topic_reports_global_topic")
  users             users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_topic_reports_user")

  @@unique([user_id, topic_id], map: "idx_unique_user_topic_report")
}

model study_sessions {
  id               Int            @id @default(autoincrement())
  user_id          Int
  subject_id       Int?
  topic_id         Int?
  start_time       DateTime       @default(now()) @db.Timestamp(6)
  end_time         DateTime?      @db.Timestamp(6)
  duration_seconds Int?           @default(0)
  created_at       DateTime?      @default(now()) @db.Timestamp(6)
  topic            global_topics? @relation(fields: [topic_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_study_sessions_global_topic")
  users            users          @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_study_sessions_user")

  @@index([user_id], map: "idx_study_sessions_user")
  @@index([start_time], map: "idx_study_sessions_start_time")
}

model notifications {
  id         Int      @id @default(autoincrement())
  user_id    Int
  title      String
  message    String
  type       String   @default("info")
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model feedback {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  rating     Int
  feedback   String   @db.Text
  category   String   @default("general") @db.VarChar(50)
  created_at DateTime @default(now()) @db.Timestamp(6)
  users      users?   @relation(fields: [user_id], references: [user_id], onDelete: SetNull)

  @@index([user_id], map: "idx_feedback_user_id")
  @@index([created_at], map: "idx_feedback_created_at")
}

model ai_token_logs {
  id                      BigInt    @id @default(autoincrement())
  user_id                 Int?
  feature_area            String    @db.VarChar(50)
  sub_feature             String?   @db.VarChar(50)
  provider                String    @db.VarChar(50)
  model_name              String    @db.VarChar(100)
  prompt_tokens           Int       @default(0)
  completion_tokens       Int       @default(0)
  total_tokens            Int       @default(0)
  cached_prompt_tokens    Int?      @default(0)
