  title       String             @db.VarChar(150)
  description String?            @db.Text
  category    String?            @default("ACADEMIC") @db.VarChar(50)
  icon        String?            @db.VarChar(50)
  order       Int                @default(1)
  created_at  DateTime?          @default(now()) @db.Timestamp(6)
